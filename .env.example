# Copy to .env and fill the values you have. The manual CAD and CalculiX
# workflow runs with the defaults. Empty credentials stay disabled.

# Meta Model API — server side only. Never put this in the frontend.
MODEL_API_KEY=
MODEL_API_BASE=https://api.meta.ai/v1
MODEL_PRIMARY=muse-spark-1.3
MODEL_REASONING=muse-wonder-1.0
MODEL_SEGMENTATION=sam-3.1

# local | modal
DRAFTY_COMPUTE=local

# Modal is used only when DRAFTY_COMPUTE=modal and both tokens are set.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Supabase. Leave blank to keep jobs on local disk.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# disabled | supabase
# Keep disabled until SUPABASE_URL is set and you want JWT checks.
DRAFTY_AUTH_MODE=disabled

# Solver. auto uses CCX_BIN when it is on PATH, otherwise the Docker image.
CCX_BIN=ccx
CCX_DOCKER_IMAGE=drafty-ccx
DRAFTY_USE_DOCKER_CCX=auto
DRAFTY_SOLVER_TIMEOUT_S=300
DRAFTY_MAX_CONCURRENT_JOBS=1
DRAFTY_MAX_GLOBAL_JOBS=2
DRAFTY_MAX_JOBS_PER_HOUR=30
DRAFTY_MAX_NODES=250000
DRAFTY_MAX_PREVIEWS_PER_HOUR=30
# auto spawns a local process. never leaves queued jobs for the worker container.
DRAFTY_SPAWN_LOCAL=auto
DRAFTY_HEARTBEAT_STALE_S=45

# Blank uses <repo>/data
DRAFTY_DATA_DIR=

FRONTEND_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:8000
