# Secrets and switches only. Model names, solver limits, and the local origin
# use the defaults in the API. Copy this file to .env.

# Meta Model API. Server side only. Never put this in frontend code.
MODEL_API_KEY=

# Supabase. SUPABASE_SECRET_KEY is the server service credential (sb_secret).
# Do not copy it into a second variable. The browser receives only the URL and
# the publishable key, through the Vite config.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# disabled | supabase
# disabled is localhost and CI. DRAFTY_ENV=production refuses to start in that mode.
DRAFTY_AUTH_MODE=disabled

# local is the default solver. modal is selected per job in Studio after
# `modal setup` or after MODAL_TOKEN_ID and MODAL_TOKEN_SECRET are set here.
DRAFTY_COMPUTE=local
